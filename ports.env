# Port layout for the ml-* MCP ecosystem.
# Sourced by run-ml-episteme.sh / run-ml-anamnesis.sh /
# run-ml-zetesis.sh / run-ml-arete.sh — change ports here, not in
# the scripts.
# All five servers live in the 28xxx block — BELOW the Linux
# ephemeral source-port range (default 32768-60999; check
# /proc/sys/net/ipv4/ip_local_port_range). Any fixed listener inside
# that range can have its port transiently stolen by an outbound
# connection's source port — a real failure mode observed with
# devin-desktop's connections. Standard: docs/a-standards/
# a-04-port-allocation.md. Agora (the lab status hub) takes the
# lowest block 2805x; Loop 0 takes 2808x, Loop 2 2806x, Loop 1
# 2807x; memory keeps 2809x.
#
# Lab status hub — read-only aggregation (ml-agora-mcp)
ML_AGORA_PORT=28050
ML_AGORA_GUI_PORT=28051
#
# Loop 2 — recursive loop (ml-arete-mcp)
ML_ARETE_PORT=28060
ML_ARETE_GUI_PORT=28061
#
# Loop 1 — search loop (ml-zetesis-mcp)
ML_ZETESIS_PORT=28070
ML_ZETESIS_GUI_PORT=28071
#
# Loop 0 — experiment loop (ml-episteme-mcp)
ML_EPISTEME_PORT=28080
ML_EPISTEME_GUI_PORT=28081
ML_EPISTEME_INGEST_PORT=28082
#
# Semantic memory — claims store (ml-anamnesis-mcp)
ML_ANAMNESIS_PORT=28090
ML_ANAMNESIS_GUI_PORT=28091
#
# Derived: GUI base URLs for cross-GUI links (the home icon every
# server's nav shows, and claim-edge hyperlinks from anamnesis into
# peer GUIs). Derived from the *_GUI_PORT vars so each port is
# declared exactly once; set any *_GUI_URL in the environment
# beforehand to point at a different host (remote browsers, lab VMs).
export ML_AGORA_GUI_URL="${ML_AGORA_GUI_URL:-http://localhost:${ML_AGORA_GUI_PORT}}"
export ML_ARETE_GUI_URL="${ML_ARETE_GUI_URL:-http://localhost:${ML_ARETE_GUI_PORT}}"
export ML_ZETESIS_GUI_URL="${ML_ZETESIS_GUI_URL:-http://localhost:${ML_ZETESIS_GUI_PORT}}"
export ML_EPISTEME_GUI_URL="${ML_EPISTEME_GUI_URL:-http://localhost:${ML_EPISTEME_GUI_PORT}}"
export ML_ANAMNESIS_GUI_URL="${ML_ANAMNESIS_GUI_URL:-http://localhost:${ML_ANAMNESIS_GUI_PORT}}"
